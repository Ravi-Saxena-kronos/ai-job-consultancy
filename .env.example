# Copy to .env locally. On Vercel: Project → Settings → Environment Variables.
# Do not commit .env or payment QR secrets.

# --- Site ---
PUBLIC_BASE_URL=https://your-project.vercel.app
ADMIN_SECRET=long-random-string-for-mark-paid-endpoint
CRON_SECRET=long-random-string-for-vercel-cron
# Email when someone registers with UPI UTR (optional — enables one-click /admin.html)
ADMIN_NOTIFY_EMAIL=

# --- Razorpay (optional — auto-verify ₹99; UPI/card incl. many UPI apps) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- UPI / Amazon Pay wallet (shown on site — no QR required) ---
UPI_VPA=8595066768@amazonpay
UPI_PAYEE_NAME=AI Job Consultancy
REGISTRATION_FEE_INR=99
DEFAULT_POSTS_REMAINING=5

# --- Google Sheets (service account JSON, one line, or paste file contents) ---
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_SHEET_ID=your_spreadsheet_id
# Optional. Omit all three unless your tab names differ from defaults below.
# SHEET_SEEKERS=SEEKERS
# SHEET_APPLICATIONS=JOB_APPLICATIONS
# SHEET_COMPANIES=COMPANY_VERIFIED

# --- Adzuna India ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_SUPPORT=support@yourdomain.com

# --- Optional: OpenAI for resume parse ---
OPENAI_API_KEY=
